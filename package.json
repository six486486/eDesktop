{
  "name": "edesktop",
  "productName": "eDesktop",
  "version": "1.1.0",
  "private": true,
  "description": "Windows 10/11 桌面整理与效率工具",
  "author": "six486486",
  "license": "MIT",
  "homepage": "https://github.com/six486486/eDesktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/six486486/eDesktop.git"
  },
  "bugs": {
    "url": "https://github.com/six486486/eDesktop/issues"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n WEB,APP -c yellow,cyan \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "test:portable-data": "node --test scripts/test-portable-data.cjs",
    "test:portable-data:electron": "electron scripts/test-portable-data-electron.cjs",
    "test:pet": "node --test desktop-pet/tests/harness.test.cjs",
    "test:pet-voice": "node --test desktop-pet/tests/voice.test.cjs",
    "test:pet-voice-ui": "electron desktop-pet/tests/voice-electron.cjs",
    "test:pet-voice-native": "electron desktop-pet/tests/voice-native.cjs",
    "test:pet-settings": "cross-env EDESKTOP_PET_SETTINGS_TEST=1 EDESKTOP_USER_DATA_PATH=.artifacts/desktop-pet-settings-test electron .",
    "test:pet-offline": "electron desktop-pet/tests/offline-electron.cjs",
    "test:pet-reminder-ui": "electron desktop-pet/tests/reminder-electron.cjs",
    "test:pet-sound": "electron desktop-pet/tests/sound-electron.cjs",
    "test:pet-reminder-model": "node desktop-pet/tests/reminder-ollama.cjs",
    "test:pet-semantics-model": "node desktop-pet/tests/semantics-ollama.cjs",
    "test:pet-memory": "node --test desktop-pet/tests/task-memory.test.cjs",
    "test:pet-memory-model": "node desktop-pet/tests/task-memory-ollama.cjs",
    "test:pet-memory-ui": "electron desktop-pet/tests/task-memory-electron.cjs",
    "dev:pet": "npm run build && electron desktop-pet/dev.cjs",
    "build": "npm run typecheck && vite build",
    "generate:icon": "node scripts/generate-app-icon.cjs",
    "prepare:electron-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-electron-runtime.ps1",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-win.ps1",
    "package:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-portable.ps1",
    "make:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-win.ps1 -Make",
    "start": "electron .",
    "capture": "npm run build && cross-env EDESKTOP_CAPTURE_PATH=.artifacts/control-center.png EDESKTOP_CAPTURE_SURFACE=control electron .",
    "capture:desktop": "npm run build && cross-env EDESKTOP_CAPTURE_PATH=.artifacts/desktop-layer.png EDESKTOP_CAPTURE_SURFACE=desktop electron .",
    "test:desktop-host": "npm run build && cross-env EDESKTOP_HOST_TEST=1 EDESKTOP_HOST_TEST_DEMO=1 EDESKTOP_HOST_TEST_REGRESSION=1 electron .",
    "test:widget-zorder": "npm run build && cross-env EDESKTOP_HOST_TEST=1 EDESKTOP_HOST_TEST_DEMO=1 EDESKTOP_WIDGET_WINDOW_TEST=1 electron .",
    "test:organizer-promotion": "npm run build && cross-env EDESKTOP_HOST_TEST=1 EDESKTOP_HOST_TEST_DEMO=1 EDESKTOP_ORGANIZER_PROMOTION_TEST=1 electron .",
    "test:drag-out": "npm run build && cross-env EDESKTOP_HOST_TEST=1 EDESKTOP_HOST_TEST_DEMO=1 EDESKTOP_DRAG_TEST=1 electron .",
    "test:login-item": "node scripts/test-login-item-path.cjs",
    "test:restore-guardian": "node scripts/test-restore-guardian.cjs",
    "test:desktop-icon-layout": "node scripts/test-desktop-icon-layout.cjs",
    "test:desktop-shell-visibility": "node scripts/test-desktop-shell-visibility.cjs",
    "test:pomodoro-flip": "node scripts/test-pomodoro-flip-continuity.cjs",
    "test:pomodoro-timing": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-pomodoro-timing.mjs",
    "test:widget-model": "node scripts/test-widget-model.cjs",
    "test:snapshots": "node scripts/test-workspace-snapshots.cjs",
    "test:snapshots:integration": "node scripts/test-workspace-snapshot-integration.cjs",
    "test:icon": "npm run generate:icon && node scripts/test-electron-icon.cjs",
    "test:icon:packaged": "node scripts/test-electron-icon.cjs out/eDesktop-win32-x64/eDesktop.exe",
    "test:safe-console": "node scripts/test-safe-console.cjs",
    "test:safe-console:electron": "node scripts/test-electron-safe-console.cjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/inter-tight": "^5.2.6",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sherpa-onnx-node": "1.13.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^39.8.5",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
